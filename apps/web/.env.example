# =============================================================================
# Variables del frontend (Vite)
#
# Cópialo a apps/web/.env. Vite incrusta las variables VITE_* en el código que
# se descarga el navegador al compilar: no pongas secretos acá. En Vercel se
# cargan en el panel del proyecto y, si cambian, hay que volver a desplegar.
# =============================================================================

# URL base de la API. Si se omite usa http://localhost:3000. La barra final se ignora.
# En producción: la URL pública de la API en Render.
VITE_API_URL=

# Clave pública VAPID, la misma VAPID_PUBLIC_KEY que usa la API. Sin ella no se
# pueden activar las notificaciones push.
# Generar el par: desde apps/api, `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=

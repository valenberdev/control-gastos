# =============================================================================
# Variables de entorno de Control de Gastos
#
# Este archivo alimenta a `docker compose` (servicios db, api y bot).
# Cópialo a `.env`, completa los valores y no lo subas: `.env` está ignorado
# por git. El frontend tiene su propio archivo: apps/web/.env.example.
#
# Las variables sin comentar son las que usa el entorno local. Las que están
# comentadas con "#" solo se usan en producción (Render) o en casos puntuales:
# el compose no las pasa a los contenedores.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos (servicio db). La API arma su DATABASE_URL con estos tres valores.
# -----------------------------------------------------------------------------
DB_USER=
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=
# No es un secreto. Los tests usan una segunda base llamada "<DB_NAME>_test"
# que hay que crear a mano (ver README, sección "Tests").
DB_NAME=control_gastos


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Firma los tokens de sesión (JWT). Obligatoria.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Clave compartida entre la API y el bot: el bot la manda en el encabezado
# x-internal-key para vincular chats y pedir tokens. Obligatoria, y tiene que
# ser el mismo valor en la API y en el bot (el compose ya lo hace).
# Generar igual que JWT_SECRET.
INTERNAL_API_KEY=

# Par de claves VAPID para las notificaciones push. Obligatorias: la API no
# arranca sin ellas. Generar (desde apps/api, después de `npm ci`):
#   npx web-push generate-vapid-keys
# La clave pública también va en apps/web/.env como VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Envío de mails de recuperación de contraseña con Resend. Opcional en local:
# sin RESEND_API_KEY el link de recuperación se imprime en el log de la API.
# Conviene usar una API key distinta en desarrollo y en producción.
RESEND_API_KEY=
# Remitente. Vacío usa "Control de Gastos <onboarding@resend.dev>" (modo de prueba de Resend).
EMAIL_FROM=

# --- Solo producción (Render) ---
# Las imágenes de producción ya fijan NODE_ENV=production; solo hace falta fuera de ellas.
# NODE_ENV=production
# Cadena de conexión a Postgres. En local la arma el compose.
# DATABASE_URL=
# Activa TLS hacia Postgres ("true" con Supabase).
# DATABASE_SSL=
# Certificado raíz del servidor en formato PEM, con los saltos de línea como \n.
# Si falta, la conexión va cifrada pero sin verificar el servidor.
# DATABASE_CA_CERT=
# URL pública del frontend (https://...). La API la usa para CORS y para armar el
# link de recuperación. En local el compose fija http://localhost:5173.
# FRONTEND_URL=
# Cantidad de proxies delante de la API (Render). Define qué IP ve el limitador
# de intentos. Medirlo; ver docs/deployment.md.
# TRUST_PROXY_HOPS=
# Contacto VAPID (https: o mailto:). Opcional: si falta se usa FRONTEND_URL cuando es https.
# Mejor una URL que un email personal: cualquier usuario puede leerlo.
# VAPID_SUBJECT=
# Zona horaria por defecto de las cuentas nuevas. Opcional.
# APP_TIMEZONE=America/Argentina/Buenos_Aires
# Puerto de la API. Render lo define solo; por defecto 3000 (el compose lo fija en 3000).
# PORT=
# La define Render sola; /health la informa como "commit".
# RENDER_GIT_COMMIT=
# "true" agrega el encabezado Server-Timing (tiempo en la base y conexiones nuevas) a
# cada respuesta. Solo para medir; ver docs/deployment.md.
# SERVER_TIMING=

# --- Solo tests ---
# TEST_DATABASE_URL, DB_INIT_SQL y DB_MIGRATIONS_DIR ya los define el compose para el
# contenedor de la API (la última apunta a db/migrations, que el test del registro de
# migraciones compara con la lista de la API); RATE_LIMIT_DISABLED la fija el setup de
# los tests. Solo hace falta TEST_DATABASE_URL si ejecutas `npm test` fuera de Docker
# (ver README).
# TEST_DATABASE_URL=
# RATE_LIMIT_DISABLED=
# DB_INIT_SQL=
# DB_MIGRATIONS_DIR=


# -----------------------------------------------------------------------------
# Bot de Telegram
# -----------------------------------------------------------------------------
# Token que entrega @BotFather. En local usa un bot de desarrollo distinto del
# de producción. Obligatoria.
TELEGRAM_BOT_TOKEN=

# --- Solo producción (Render) ---
# En local el bot corre en modo "polling" y no necesita estas variables.
# BOT_MODE=webhook
# URL pública de la API (en el compose es http://api:3000).
# API_URL=
# Secreto con el que Telegram firma cada webhook. Obligatoria en modo webhook.
# Generar igual que JWT_SECRET.
# WEBHOOK_SECRET=
# Opcional: Render la define sola (RENDER_EXTERNAL_URL) y el bot arma la URL
# del webhook a partir de ella.
# WEBHOOK_URL=
# Puerto del servidor HTTP del bot en modo webhook. Render lo define solo; por defecto 3000.
# PORT=